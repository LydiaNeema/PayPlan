__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.env/
*.env

# Requirements (ignore local requirements file)
requirements.txt

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

